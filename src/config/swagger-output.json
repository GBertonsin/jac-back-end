  "components": {
    "securityDefinitions": {
      "bearerAuth": {
        "type": "apiKey",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "AuthorizationHeaderRequired": {
        "name": "authorization",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
        "description": "JWT Bearer token. Ex.: 'Bearer <token>'"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 403
          },
          "message": {
            "type": "string",
            "example": "Sem permissão"
          }
        }
      },
      "UserRegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "[john@example.com](mailto:john@example.com)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "secret123"
          },
          "role": {
            "type": "string",
            "description": "USER | ORGANIZER | ADMIN (opcional)",
            "example": "USER"
          }
        }
      },
      "UserRegisterResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "c9a6f2c0-0c8e-4a3c-8f2a-9d0a1a2b3c4d"
          },
          "email": {
            "type": "string",
            "example": "[john@example.com](mailto:john@example.com)"
          }
        }
      },
      "UserLoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "[john@example.com](mailto:john@example.com)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "secret123"
          }
        }
      },
      "UserLoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT válido por 7 dias",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "evt_123"
          },
          "title": {
            "type": "string",
            "example": "Semana da Engenharia"
          },
          "description": {
            "type": "string",
            "example": "Palestras e oficinas sobre engenharia de software"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-01T13:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-01T17:00:00Z"
          },
          "location": {
            "type": "string",
            "example": "Auditório Central"
          },
          "requireGeo": {
            "type": "boolean",
            "example": true
          },
          "geofenceLat": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": -16.3281
          },
          "geofenceLng": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": -48.9534
          },
          "geofenceRadiusM": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": 120
          },
          "createdById": {
            "type": "string",
            "example": "usr_abc"
          }
        }
      },
      "CreateEventDTO": {
        "type": "object",
        "required": [
          "title",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Semana da Engenharia"
          },
          "description": {
            "type": "string",
            "example": "Palestras e oficinas sobre engenharia de software"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-01T13:00:00Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-01T17:00:00Z"
          },
          "location": {
            "type": "string",
            "example": "Auditório Central"
          },
          "requireGeo": {
            "type": "boolean",
            "example": true
          },
          "geofenceLat": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": -16.3281
          },
          "geofenceLng": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": -48.9534
          },
          "geofenceRadiusM": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": 120
          }
        }
      },
